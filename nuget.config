<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!-- Local feed for the Andy.CK computable-knowledge engine packages consumed
         by Andy.Tools.CK. Produced by `dotnet pack -c Release -o ./local-feed`
         in ../andy-computable-knowledge; see its docs/10-operations/04-releasing.md.
         Remove once Andy.CK.* is published to nuget.org. -->
    <add key="andy-ck-local" value="../andy-computable-knowledge/local-feed" />
  </packageSources>
</configuration>
